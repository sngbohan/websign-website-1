    "glass-light": "rgba(248,249,252,0.8) + saturate(170%) blur(20px)",
    "glass-dark": "rgba(13,17,25,0.78) + saturate(170%) blur(20px)",
    "control-pill": "rgba(18,24,38,0.72)",
    "curtain-light": "rgba(213,219,230,0.45) + blur(20px)",
    "curtain-dark": "rgba(5,7,12,0.55) + blur(20px)"
