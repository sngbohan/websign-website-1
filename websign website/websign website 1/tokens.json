    "text": {
      "note": "Verlaufstext nutzt je Theme nur den Abschnitt des Markenverlaufs, der als große Schrift mindestens 3:1 erreicht. Nur ab headline-s.",
      "brand-light": "linear-gradient(100deg, #5474b0 0%, #4766a0 40%, #284172 100%)",
      "brand-dark": "linear-gradient(100deg, #c6d2e5 0%, #7f9bd0 55%, #6787c4 100%)",
