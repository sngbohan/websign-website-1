  "depth-grid": {
    "line": "1px, --line mit 40 % Deckkraft",
    "tilt": "64 (Grad, ohne Einheit; über motion.js steuerbar)",
    "cell": "72px",
    "horizon": "42%"
  },
  "layout": {
    "band": "min(1260px, 87.5%)",
    "gutter": "calc(50% - min(1260px, 87.5%) / 2)",
    "grid-gap": "24px",
    "tile-gap": "12px",
    "section-pad": {
      "L": "144px",
      "M": "112px",
      "S": "80px"
    },
    "header-gap": {
      "L": "48px",
      "S": "32px"
    },
    "nav-height": "48px",
    "hit": "44px"
  },
  "radius": {
    "button": "999px",
    "tab": "999px",
    "card": "24px",
    "tile": "16px",
    "form": "12px",
    "badge": "6px",
    "round": "50%"
  },
  "motion": {
    "ease-ws": "cubic-bezier(0.22, 0.8, 0.2, 1)",
    "ease-ws-ui": "cubic-bezier(0.3, 0.7, 0.2, 1)",
    "duration": {
      "micro": "140ms",
      "ui": "280ms",
      "text": "560ms",
      "scene": "an den Scroll gekoppelt (motion.js)"
    },
    "reveal": {
      "distance": "24px",
      "move": "560ms",
      "fade": "720ms",
      "stagger": "90ms"
    },
    "hover-scale": 1.012
  },
  "breakpoint": {
    "S": "<= 734px",
    "M": "735-1068px",
    "L": ">= 1069px"
  }
}
