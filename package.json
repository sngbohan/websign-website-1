{
  "name": "websign-website",
  "private": true,
  "type": "module",
  "description": "Websign. Die Seite selbst braucht keinen Build. Nur die React-Inseln (src/) werden gebündelt: npm run build.",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "node -e \"require('fs').rmSync('assets/js/chunks',{recursive:true,force:true})\" && esbuild src/glow-cards.tsx src/curved-carousel.tsx --bundle --splitting --format=esm --minify --target=es2020 --legal-comments=none --define:process.env.NODE_ENV='\"production\"' --outdir=assets/js --chunk-names=chunks/[name]-[hash]",
    "build:css": "tailwindcss -i src/glow-cards.css -o assets/css/glow-cards.css --minify",
    "typecheck": "tsc --noEmit",
    "check": "node tools/check.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2"
  }
}
